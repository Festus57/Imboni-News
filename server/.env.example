# ── Required ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=10000

# MongoDB Atlas connection string (NOT localhost — must be cloud)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/imboni_news_db?retryWrites=true&w=majority

# JWT — use a long random string, min 32 characters
JWT_SECRET=replace_with_a_very_long_random_secret_string_here
JWT_EXPIRES_IN=7d

# ── CORS — your Vercel URLs (comma-separate if multiple) ──────────────────────
CLIENT_URL=https://your-client.vercel.app
ADMIN_URL=https://your-admin.vercel.app

# ── Optional ──────────────────────────────────────────────────────────────────
APP_TIME_ZONE=Africa/Kigali
TRUST_PROXY=true

# Seed script only (npm run seed) — not needed in production after first run
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@imboni.rw
ADMIN_PASSWORD=YourSecurePassword123!
